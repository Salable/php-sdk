{
  "name": "salable/sdk",
  "description": "Official PHP SDK for the Salable API",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "api",
    "billing",
    "salable",
    "sdk",
    "subscriptions"
  ],
  "homepage": "https://github.com/Salable/php-sdk",
  "support": {
    "issues": "https://github.com/Salable/php-sdk/issues",
    "source": "https://github.com/Salable/php-sdk"
  },
  "authors": [
    {
      "name": "Salable"
    }
  ],
  "require": {
    "composer-runtime-api": "^2.2",
    "microsoft/kiota-abstractions": "^1.5.2",
    "microsoft/kiota-http-guzzle": "^1.5.2",
    "microsoft/kiota-serialization-form": "^1.5.2",
    "microsoft/kiota-serialization-json": "^1.5.2",
    "microsoft/kiota-serialization-multipart": "^1.5.2",
    "microsoft/kiota-serialization-text": "^1.5.2",
    "php": "^8.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Salable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Salable\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.99"
    },
    "sort-packages": true
  },
  "scripts": {
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix",
    "stan": "phpstan analyse --no-progress",
    "test": "phpunit"
  }
}
